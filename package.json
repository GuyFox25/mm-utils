{
  "name": "kit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared platform toolkit — layered, domain-agnostic TypeScript packages.",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^4.1.11"
  }
}
